{
    "name": "copilot-agent-nameplate",
    "version": "1.0.0",
    "displayName": "Copilot Agent Nameplate",
    "description": "Rename Copilot Studio agents per environment — without an unmanaged layer. The solution package arrives already named for its target.",
    "type": "module",
    "main": "index.html",
    "icon": "dist/logo.svg",
    "author": "Power Platform ToolBox",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsc && vite build && vite build --config vite.headless.config.ts",
        "dev": "vite",
        "watch": "vite build --watch",
        "dev-watch": "vite build --mode development --watch",
        "preview": "vite preview",
        "smoke": "tsx scripts/smoke-package.mts",
        "finalize-package": "npm shrinkwrap",
        "validate": "pptb-validate",
        "version-stable": "npm version patch --no-git-tag-version",
        "publish-package": "npm run build && npm run version-stable && npm publish --access public",
        "build-headless": "vite build --config vite.headless.config.ts"
    },
    "devDependencies": {
        "@pptb/types": "^1.2.0",
        "@xmldom/xmldom": "^0.9.12",
        "tsx": "^4.19.2",
        "typescript": "^5.0.0",
        "vite": "^8.0.3"
    },
    "files": [
        "dist",
        "npm-shrinkwrap.json"
    ],
    "dependencies": {
        "fflate": "0.8.2"
    },
    "contributors": [
        {
            "name": "Vincenzo Sguera"
        }
    ],
    "keywords": [
        "pptb",
        "power-platform",
        "copilot-studio",
        "agents",
        "alm",
        "solution",
        "package",
        "rename",
        "managed-layer"
    ],
    "configurations": {
        "repository": "https://github.com/vincenzosgueradev/copilot-agent-nameplate",
        "readmeUrl": "https://raw.githubusercontent.com/vincenzosgueradev/copilot-agent-nameplate/main/tools/README.md",
        "category": "Copilot Studio"
    },
    "features": {
        "connections": {
            "min": 1,
            "max": 2
        }
    }
}
