{
    "name": "@vincenzosgueradev/pptb-copilot-nameplate",
    "version": "1.1.4",
    "displayName": "Agent Nameplate",
    "description": "Rename Copilot Studio agents per environment without an unmanaged layer. Pick a solution, set a suffix such as [UAT], and get a verified managed package where every agent display name is already set for its target. Optionally raises the solution version in DEV, with your confirmation.",
    "type": "module",
    "main": "index.html",
    "icon": "logo.svg",
    "author": "Vincenzo Sguera",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite",
        "watch": "vite build --watch",
        "dev-watch": "vite build --mode development --watch",
        "preview": "vite preview",
        "smoke": "tsx scripts/smoke-package.mts",
        "test": "vitest run",
        "test:full": "cross-env TEST_FULL=1 vitest run",
        "test:mutation": "node scripts/mutation-check.mjs",
        "test:watch": "vitest",
        "smoke:multi": "tsx scripts/smoke-multi-agent.mts",
        "finalize-package": "npm shrinkwrap",
        "validate": "pptb-validate",
        "version-stable": "npm version patch --no-git-tag-version",
        "publish-package": "npm run build && npm run version-stable && npm publish --access public",
        "build-headless": "vite build --config vite.headless.config.ts"
    },
    "devDependencies": {
        "@pptb/types": "^1.2.0",
        "@types/node": "^26.6.5",
        "@xmldom/xmldom": "^0.9.12",
        "cross-env": "^10.1.0",
        "jsdom": "^30.1.3",
        "tsx": "^4.19.2",
        "typescript": "^5.0.0",
        "vite": "^8.0.3",
        "vitest": "^5.0.5"
    },
    "files": [
        "dist",
        "npm-shrinkwrap.json"
    ],
    "dependencies": {
        "fflate": "0.8.2"
    },
    "contributors": [
        {
            "name": "Vincenzo Sguera",
            "url": "https://github.com/vincenzosgueradev"
        }
    ],
    "keywords": [
        "pptb",
        "power-platform",
        "copilot-studio",
        "agents",
        "alm",
        "solution",
        "package",
        "rename",
        "managed-layer"
    ],
    "configurations": {
        "repository": "https://github.com/vincenzosgueradev/copilot-agent-nameplate",
        "readmeUrl": "https://raw.githubusercontent.com/vincenzosgueradev/copilot-agent-nameplate/main/README.md",
        "website": "https://github.com/vincenzosgueradev/copilot-agent-nameplate",
        "category": "Copilot Studio"
    },
    "features": {
        "minAPI": "1.2.7",
        "connections": 1
    }
}
